{
  "name": "dsh-qq-gateway",
  "version": "1.0.2",
  "description": "QQ 消息网关：NapCat / OneBot 11 收 QQ 消息投给 DSH 会话，助手回复自动回传 QQ；附带 qq_* 模型工具、主号管理指令、拟人延迟与禁回。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "prepublishOnly": "node test/run-all.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "onebot",
    "onebot11",
    "napcat",
    "qqbot",
    "messaging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawwiMA/dsh-qq-gateway.git"
  },
  "homepage": "https://github.com/ShawwiMA/dsh-qq-gateway#readme",
  "bugs": {
    "url": "https://github.com/ShawwiMA/dsh-qq-gateway/issues"
  },
  "author": "ShawwiMA",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
